github_repository_owner_id = "<owner-id>"

groups = {
  billing_viewers     = "gcp-billing-viewers@example.com"
  organization_admins = "gcp-organization-admins@example.com"
  security_reviewers  = "gcp-security-reviewers@example.com"
}

local_plan_principals = [
  "user:<name>@example.com",
]
